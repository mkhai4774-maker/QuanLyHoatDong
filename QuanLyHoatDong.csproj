<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>QuanLyHoatDong</RootNamespace>
    <AssemblyName>QuanLyHoatDong</AssemblyName>
    <!-- Chỉ giữ ngôn ngữ mặc định, bỏ các thư mục dịch (de, fr, ja...) của thư viện cho gọn -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="PDFsharp-GDI" Version="6.1.1" />
  </ItemGroup>

</Project>
